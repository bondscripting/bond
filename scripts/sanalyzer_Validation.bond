void ValidBreakAndContinue(int x)
{
	while (x < 5)
	{
		if (x == 1)
		{
			break;
		}
		else
		{
			continue;
		}
	}

	while (x < 5)
	{
		switch (x)
		{
			case 1:
				if (x == 1)
				{
					continue;
				}
				break;
		}
	}
}

int AllPathsReturnAValue1(int x)
{
	return x;
}

int AllPathsReturnAValue2(int x)
{
	switch (x)
	{
		case 1:
			return 2;
		default:
		case 2:
			return 3;
	}
}

int AllPathsReturnAValue3(int x)
{
	if (x == 1)
	{
		return 2;
	}
	else
	{
		return 3;
	}
}

int AllPathsReturnAValue4(int x)
{
	if (x == 1)
	{
		switch (x)
		{
			case 1:
				return 1;
			default:
				return 2;
		}
	}
	else
	{
		return 3;
	}
}

void ValidEmptyReturn(int x)
{
	if (x == 1)
	{
		return;
	}
	x = 2;
}
