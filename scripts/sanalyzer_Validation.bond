void ValidBreakAndContinue(int x)
{
	while (x < 5)
	{
		if (x == 1)
		{
			break;
		}
		else
		{
			continue;
		}
	}

	while (x < 5)
	{
		switch (x)
		{
			case 1:
				if (x == 1)
				{
					continue;
				}
				break;
		}
	}
}

int AllPathsReturnAValue1(int x)
{
	return x;
}

int AllPathsReturnAValue2(int x)
{
	switch (x)
	{
		case 1:
			return 2;
		default:
		case 2:
			return 3;
	}
}

int AllPathsReturnAValue3(int x)
{
	if (x == 1)
	{
		return 2;
	}
	else
	{
		return 3;
	}
}

int AllPathsReturnAValue4(int x)
{
	if (x == 1)
	{
		switch (x)
		{
			case 1:
				return 1;
			default:
				return 2;
		}
	}
	else
	{
		return 3;
	}
}

void ValidEmptyReturn(int x)
{
	if (x == 1)
	{
		return;
	}
	x = 2;
}

int AllPathsReturnAValue5(int x)
{
	while (x > 0)
	{
		return 1;
	}
	for (int i = 0; i < x; ++i)
	{
		return i;
	}
	return 0;
}

int AllPathsReturnAValue6(int x)
{
	// The body of a do-while loop always runs.
	do
	{
		return x;
	}
	while (x > 0);
}

void TernaryPointerToConst(bool b, int *p, const int *cq)
{
	const int *r1 = b ? p : cq;
	const int *r2 = b ? cq : p;
	const int *r3 = b ? p : null;
}

int ReachableAfterSwitchWithBreak(int x)
{
	// The break leaves the switch, so the return after it is reachable.
	switch (x)
	{
		case 1:
			if (x == 1)
			{
				break;
			}
			return 1;
		default:
			return 2;
	}
	return 3;
}

int AllPathsReturnAValue7(int x)
{
	// The break leaves the inner loop, not the switch.
	switch (x)
	{
		case 1:
			while (x > 0)
			{
				if (x == 5)
				{
					break;
				}
				--x;
			}
			return 1;
		default:
			return 2;
	}
}

int AllPathsReturnAValue8(int x)
{
	// The breaks leave the inner switch, not the do-while loop.
	do
	{
		switch (x)
		{
			case 1:
				break;
			default:
				x = 2;
				break;
		}
		return x;
	}
	while (x > 0);
}

int AllPathsReturnAValue9(int x)
{
	// A continue in a do-while loop with a constant true condition runs the body again.
	do
	{
		if (x == 1)
		{
			continue;
		}
		return x;
	}
	while (true);
}
