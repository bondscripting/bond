int Addi(int *a, int b)
{
	return *a += b;
}

long Addl(long *a, long b)
{
	return *a += b;
}

float Addf(float *a, float b)
{
	return *a += b;
}

double Addd(double *a, double b)
{
	return *a += b;
}

int Subi(int *a, int b)
{
	return *a -= b;
}

long Subl(long *a, long b)
{
	return *a -= b;
}

float Subf(float *a, float b)
{
	return *a -= b;
}

double Subd(double *a, double b)
{
	return *a -= b;
}

int Muli(int *a, int b)
{
	return *a *= b;
}

uint Mului(uint *a, uint b)
{
	return *a *= b;
}

long Mull(long *a, long b)
{
	return *a *= b;
}

ulong Mulul(ulong *a, ulong b)
{
	return *a *= b;
}

float Mulf(float *a, float b)
{
	return *a *= b;
}

double Muld(double *a, double b)
{
	return *a *= b;
}

int Divi(int *a, int b)
{
	return *a /= b;
}

uint Divui(uint *a, uint b)
{
	return *a /= b;
}

long Divl(long *a, long b)
{
	return *a /= b;
}

ulong Divul(ulong *a, ulong b)
{
	return *a /= b;
}

float Divf(float *a, float b)
{
	return *a /= b;
}

double Divd(double *a, double b)
{
	return *a /= b;
}

int Remi(int *a, int b)
{
	return *a %= b;
}

uint Remui(uint *a, uint b)
{
	return *a %= b;
}

long Reml(long *a, long b)
{
	return *a %= b;
}

ulong Remul(ulong *a, ulong b)
{
	return *a %= b;
}

int Lshi(int *a, int b)
{
	return *a <<= b;
}

long Lshl(long *a, long b)
{
	return *a <<= b;
}

int Rshi(int *a, int b)
{
	return *a >>= b;
}

uint Rshui(uint *a, uint b)
{
	return *a >>= b;
}

long Rshl(long *a, long b)
{
	return *a >>= b;
}

ulong Rshul(ulong *a, ulong b)
{
	return *a >>= b;
}

uint RshuiInt(uint *a, int b)
{
	return *a >>= b;
}

long LshlInt(long *a, int b)
{
	return *a <<= b;
}

int Andi(int *a, int b)
{
	return *a &= b;
}

long Andl(long *a, long b)
{
	return *a &= b;
}

int Ori(int *a, int b)
{
	return *a |= b;
}

long Orl(long *a, long b)
{
	return *a |= b;
}

int Xori(int *a, int b)
{
	return *a ^= b;
}

long Xorl(long *a, long b)
{
	return *a ^= b;
}

int AddFloatToLocal(int a)
{
	// Must not be optimized to an inci instruction.
	int b;
	int c = a;
	c += 0.5f;
	return c;
}

int SubDoubleFromLocal(int a)
{
	// Must not be optimized to an inci instruction.
	int b;
	int c = a;
	c -= 0.5;
	return c;
}

int AddToParam(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	a += 5;
	return a;
}

int SubFromParamValue(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	return a -= 7;
}

long AddToLongParam(long a)
{
	// Should be optimized to an incl instruction with a negative slot index.
	a += 100;
	return a;
}

long SubFromLongParamValue(int a, long b)
{
	// Should be optimized to an incl instruction with a slot index below -1.
	return b -= 100;
}
