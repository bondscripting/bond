void LossyConversions1()
{
	// Bad
	char c = -129;
	c = 128;

	c = -129L;
	c = 128L;
	c = 128LU;

	c = -129.0f;
	c = 128.0f;
	c = 1.1f;

	c = -129.0;
	c = 128.0;
	c = 1.1;

	uchar uc = -1;
	uc = 256;

	uc = -1L;
	uc = 256L;
	uc = 256LU;

	uc = -1.0f;
	uc = 256.0f;
	uc = 1.1f;

	uc = -1.0;
	uc = 256.0;
	uc = 1.1;

	short s = -32769;
	s = 32768;

	s = -32769L;
	s = 32768L;
	s = 32768LU;

	s = -32769.0f;
	s = 32768.0f;

	s = -32769.0;
	s = 32768.0;

	ushort us = -1;
	us = 65536;

	us = -1L;
	us = 65536L;
	us = 65536LU;

	us = -1.0f;
	us = 65536.0f;

	us = -1.0;
	us = 65536.0;

	int i = 0x80000000U;

	i = 0x80000000L;
	i = -0x80000001L;
	i = 0x80000000LU;

	i = cast<float>(0x80000000U);
	i = -cast<float>(0x81000000U);
	i = 1.1f;

	i = cast<double>(0x80000000U);
	i = -cast<double>(0x81000000U);
	i = 1.1;

	uint ui = -1;

	ui = -1L;
	ui = 0x100000000L;
	ui = 0x100000000LU;

	ui = -1.0f;
	ui = cast<float>(0x100000000L);

	ui = -1.0;
	ui = cast<double>(0x100000000L);
}
