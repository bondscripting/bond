void VoidPointerConversions(int *ip, void *vp)
{
	void *v = ip;
	int *i = vp;
	v = ip;
	i = vp;
}

void CharPointerArithmetic(char *p, char *q)
{
	char *r = p + 1;
	r = 1 + p;
	r = p - 1;
	p - q;
	p += 1;
	p -= 1;
	p[1];
	++p;
	p++;
	--p;
	p--;
}
