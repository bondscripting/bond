int Negi(int a)
{
	return -a;
}

long Negl(long a)
{
	return -a;
}

float Negf(float a)
{
	return -a;
}

double Negd(double a)
{
	return -a;
}

bool Not(bool a)
{
	return !a;
}

int BitNoti(int a)
{
	return ~a;
}

uint BitNotui(uint a)
{
	return ~a;
}

long BitNotl(long a)
{
	return ~a;
}

ulong BitNotul(ulong a)
{
	return ~a;
}

int Preinc1(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	++a;
	return a;
}

int Preinc2(int a)
{
	// Should be optimized to an inci instruction.
	int b;
	int c = a;
	++c;
	return c;
}

short Preinc3(short a)
{
	// Should push 1, add then pop.
	short b;
	short c = a;
	++c;
	return c;
}

int Preinc4(int a)
{
	// Should push 1, add then pop.
	int[2000] b;
	int c = a;
	++c;
	return c;
}

int Preinc5(int *a)
{
	// Does gymnastics to store the new value and leave a temporary on the stack.
	return ++(*a);
}

int Postinc1(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	a++;
	return a;
}

int Postinc2(int a)
{
	// Should be optimized to an inci instruction.
	int b;
	int c = a;
	c++;
	return c;
}

short Postinc3(short a)
{
	// Should push 1, add then pop.
	short b;
	short c = a;
	c++;
	return c;
}

int Postinc4(int a)
{
	// Should push 1, add then pop.
	int[2000] b;
	int c = a;
	c++;
	return c;
}

int Postinc5(int *a)
{
	// Does gymnastics to store the new value and leave a temporary on the stack.
	return (*a)++;
}

int Predec1(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	--a;
	return a;
}

int Predec2(int a)
{
	// Should be optimized to an deci instruction.
	int b;
	int c = a;
	--c;
	return c;
}

short Predec3(short a)
{
	// Should push 1, add then pop.
	short b;
	short c = a;
	--c;
	return c;
}

int Predec4(int a)
{
	// Should push 1, add then pop.
	int[2000] b;
	int c = a;
	--c;
	return c;
}

int Predec5(int *a)
{
	// Does gymnastics to store the new value and leave a temporary on the stack.
	return --(*a);
}

int Postdec1(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	a--;
	return a;
}

int Postdec2(int a)
{
	// Should be optimized to an deci instruction.
	int b;
	int c = a;
	c--;
	return c;
}

short Postdec3(short a)
{
	// Should push 1, add then pop.
	short b;
	short c = a;
	c--;
	return c;
}

int Postdec4(int a)
{
	// Should push 1, add then pop.
	int[2000] b;
	int c = a;
	c--;
	return c;
}

int Postdec5(int *a)
{
	// Does gymnastics to store the new value and leave a temporary on the stack.
	return (*a)--;
}

int PreincParamValue(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	return ++a;
}

int PostincParamValue(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	return a++;
}

int PredecParamValue(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	return --a;
}

int PostdecParamValue(int a)
{
	// Should be optimized to an inci instruction with a negative slot index.
	return a--;
}

int IncSecondParam(int a, int b)
{
	// Should be optimized to inci instructions with a slot index below -1.
	++b;
	b++;
	return b;
}

long PreincLongParam(long a)
{
	// Should be optimized to an incl instruction with a negative slot index.
	++a;
	return a;
}

long PostincLongParam(long a)
{
	// Should be optimized to an incl instruction with a negative slot index.
	return a++;
}

long PredecLongParam(long a)
{
	// Should be optimized to an incl instruction with a negative slot index.
	--a;
	return a;
}

long PostdecLongParam(long a)
{
	// Should be optimized to an incl instruction with a negative slot index.
	return a--;
}
