// The following loops compile to jumps that target themselves or each other. Compiling them must
// terminate. They are never called.
void InfiniteFor()
{
	for (;;);
}

void InfiniteForBraces()
{
	for (;;) {}
}

void InfiniteForContinue()
{
	for (;;) continue;
}

// The back edge targets the break, which jumps past the loop.
int ForBreak()
{
	for (;;) break;
	return 1;
}

int TableSwitchNearMin(int a)
{
	int b = 4;
	switch (a)
	{
		case -2147483647 - 1:
			b = 5;
			break;
		case -2147483647:
			b = 6;
			break;
		case -2147483646:
			b = 7;
			break;
	}
	return b;
}
