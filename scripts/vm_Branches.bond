bool And(bool a, bool b)
{
	return a && b;
}

bool Or(bool a, bool b)
{
	return a || b;
}

int AndShortCircuit(bool a)
{
	int b = 4;
	a = a && ((b = 5) == 5);
	return b;
}

int OrShortCircuit(bool a)
{
	int b = 4;
	a = a || ((b = 5) == 5);
	return b;
}

int Ternary(bool a)
{
	return a ? 4 : 5;
}

int If(bool a)
{
	int b = 5;
	if (a)
	{
		b = 4;
	}
	return b;
}

int IfNot(bool a)
{
	int b = 5;
	if (!a)
	{
		b = 4;
	}
	return b;
}

int IfNotAAndNotB(bool a, bool b)
{
	int c = 5;
	if (!a && !b)
	{
		c = 4;
	}
	return c;
}

int IfNotAOrNotB(bool a, bool b)
{
	int c = 5;
	if (!a || !b)
	{
		c = 4;
	}
	return c;
}

int IfElse(bool a)
{
	int b = 3;
	if (a)
	{
		b = 4;
	}
	else
	{
		b = 5;
	}
	return b;
}

int ElseIf(bool a, bool b)
{
	int c = 3;
	if (a)
	{
		c = 4;
	}
	else if (b)
	{
		c = 5;
	}
	else
	{
		c = 6;
	}
	return c;
}

int NestedIf(bool a, bool b)
{
	int c = 3;
	if (a)
	{
		if (b)
		{
			c = 4;
		}
		else
		{
			c = 5;
		}
	}
	else
	{
		if (b)
		{
			c = 6;
		}
		else
		{
			c = 7;
		}
	}
	return c;
}

int LookupSwitchDefault(int a)
{
	int b = 4;
	switch (a)
	{
		case 1:
			b = 5;
			break;
		case 100:
			b = 7;
			break;
		default:
			b = 8;
			break;
		case 3:
			b = 6;
			break;
	}
	return b;
}

int LookupSwitchNoDefault(int a)
{
	int b = 4;
	switch (a)
	{
		case 1:
			b = 5;
			break;
		case 100:
			b = 7;
			break;
		case 3:
			b = 6;
			break;
	}
	return b;
}

int TableSwitchDefault(int a)
{
	int b = 4;
	switch (a)
	{
		case 8:
			b = 6;
			break;
		case 11:
			b = 8;
			break;
		case 7:
			b = 5;
			break;
		default:
			b = 9;
			break;
		case 10:
			b = 7;
			break;
	}
	return b;
}

int TableSwitchNoDefault(int a)
{
	int b = 4;
	switch (a)
	{
		case 8:
			b = 6;
			break;
		case 11:
			b = 8;
			break;
		case 7:
			b = 5;
			break;
		case 10:
			b = 7;
			break;
	}
	return b;
}

int While(int a)
{
	int b = 0;
	while (b < a)
	{
		b = b + 1;
	}
	return b;
}

int For(int a)
{
	int b = 0;
	for (int i = 0; i < a; ++i)
	{
		b = b + 1;
	}
	return b;
}

int NestedLoopsWithJumps(int a, int b)
{
	int c = 0;

	for (int i = 0; ;++i)
	{
		if (i == 3)
		{
			continue;
		}

		for (int j = 0; ;++j)
		{
			if (j == 6)
			{
				continue;
			}

			c += (i * j);

			if (j == b)
			{
				break;
			}
		}

		if (i == a)
		{
			break;
		}
	}

	return c;
}

int IfLtf(float a, float b)
{
	if (a < b)
	{
		return 1;
	}
	return 2;
}

int IfLtd(double a, double b)
{
	if (a < b)
	{
		return 1;
	}
	return 2;
}

int IfNotLtf(float a, float b)
{
	if (!(a < b))
	{
		return 1;
	}
	return 2;
}

int IfNotLtd(double a, double b)
{
	if (!(a < b))
	{
		return 1;
	}
	return 2;
}

int TernaryLt(double a, double b)
{
	return (a < b) ? 1 : 2;
}

int TernaryNotLt(double a, double b)
{
	return !(a < b) ? 1 : 2;
}

int WhileLt(double a, double b)
{
	int n = 0;
	while (a < b)
	{
		++n;
		if (n == 3)
		{
			break;
		}
	}
	return n;
}

int DoWhileLt(double a, double b)
{
	int n = 0;
	do
	{
		++n;
		if (n == 3)
		{
			break;
		}
	}
	while (a < b);
	return n;
}

int ForLt(double a, double b)
{
	int n = 0;
	for (int i = 0; a < b; ++i)
	{
		++n;
		if (n == 3)
		{
			break;
		}
	}
	return n;
}

bool AndLt(double a, double b)
{
	return (a < b) && (a <= b);
}

bool OrLt(double a, double b)
{
	return (a < b) || (a > b);
}

bool NotLtAndNotGt(double a, double b)
{
	return !(a < b) && !(a > b);
}

int IfNotLtOrGt(double a, double b)
{
	if (!((a < b) || (a > b)))
	{
		return 1;
	}
	return 2;
}

bool ReturnNotLt(double a, double b)
{
	return !(a < b);
}

int DoWhile(int a)
{
	int n = 0;
	do
	{
		++n;
	}
	while (n < a);
	return n;
}

// A continue must jump to the condition. If it jumped to the top of the body instead, the loop
// would not stop until n reached 10.
int DoWhileContinue(int a)
{
	int n = 0;
	int m = 0;
	do
	{
		++n;
		if (n < 10)
		{
			continue;
		}
		++m;
	}
	while (n < a);
	return n + (m * 100);
}

// A continue must run the increment expression.
int ForContinue(int a)
{
	int n = 0;
	for (int i = 0; i < a; ++i)
	{
		++n;
		if ((i % 2) == 0)
		{
			continue;
		}
		n += 100;
	}
	return n;
}

// Every switch section must end with a jump, so the only fall-through is several labels sharing
// one section.
int SwitchSharedSection(int a)
{
	int b = 4;
	switch (a)
	{
		case 1:
		case 2:
			b = 5;
			break;
		case 3:
		default:
		case 5:
			b = 6;
			break;
		case 6:
			b = 7;
			break;
	}
	return b;
}

