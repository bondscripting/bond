void TestContinue(int a)
{
	while (true) continue;
}

void TestBreak(int a)
{
	while (true) break;
}

void TestReturn1(int a)
{
	return;
}

bool TestReturn2(int a)
{
	return (a > 10);
}

void TestDoContinue(int a)
{
	do
	{
		if (a > 1)
			continue;
		++a;
	}
	while (a < 5);
}

void TestDoBreak(int a)
{
	do
	{
		break;
	}
	while (true);
}
