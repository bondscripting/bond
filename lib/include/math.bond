/// \param x The first value.
/// \param y The second value.
char MinC(char x, char y);

/// \brief Returns the smaller of two values.
/// \param x The first value.
/// \param y The second value.
uchar MinUC(uchar x, uchar y);

/// \brief Returns the smaller of two values.
/// \param x The first value.
