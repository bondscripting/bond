namespace Bond
{

/// \defgroup math math.bond
/// \brief A collection of functions and constants for performing math operations.
///
/// \code
/// include "math.bond";
/// \endcode

/// @{

/// \brief The value of pi as a double.
const double PI_D = 3.14159265358979323846;

/// \brief The value of pi as a float.
const float PI_F = cast<float>(PI_D);

/// \brief The value of pi/2 as a double.
const double HALF_PI_D = PI_D / 2.0;

/// \brief The value of pi/2 as a float.
const float HALF_PI_F = cast<float>(HALF_PI_D);

/// \brief The value of 2pi as a double.
const double TWO_PI_D = PI_D * 2.0;

/// \brief The value of 2pi as a float.
const float TWO_PI_F = cast<float>(TWO_PI_D);

/// \brief The value of e as a double.
const double E_D = 2.71828182845904523536;

/// \brief The value of e as a float.
const float E_F = cast<float>(E_D);

/// \brief The natural logarithm of 2 as a double.
const double LN2_D = 0.69314718055994530942;

/// \brief The natural logarithm of 2 as a float.
const float LN2_F = cast<float>(LN2_D);

/// \brief The natural logarithm of 10 as a double.
const double LN10_D = 2.30258509299404568402;

/// \brief The natural logarithm of 10 as a float.
const float LN10_F = cast<float>(LN10_D);

/// \brief The base-2 logarithm of e as a double.
const double LOG2E_D = 1.44269504088896340736;

/// \brief The base-2 logarithm of e as a float.
const float LOG2E_F = cast<float>(LOG2E_D);

/// \brief The base-10 logarithm of e as a double.
const double LOG10E_D = 0.43429448190325182765;

/// \brief The base-10 logarithm of e as a float.
const float LOG10E_F = cast<float>(LOG10E_D);

/// \brief The square root of 2 as a double.
const double SQRT2_D = 1.41421356237309504880;

/// \brief The square root of 2 as a float.
const float SQRT2_F = cast<float>(SQRT2_D);

/// \brief The square root of 1/2 as a double.
const double SQRT1_2_D = 0.70710678118654752440;

/// \brief The square root of 1/2 as a float.
const float SQRT1_2_F = cast<float>(SQRT1_2_D);

/// \brief Returns the sine of an angle in radians.
/// \param x An angle expressed in radians.
double SinD(double x);

/// \brief Returns the sine of an angle in radians.
/// \param x An angle expressed in radians.
float SinF(float x);

/// \brief Returns the cosine of an angle in radians.
/// \param x An angle expressed in radians.
double CosD(double x);

/// \brief Returns the cosine of an angle in radians.
/// \param x An angle expressed in radians.
float CosF(float x);

/// \brief Returns the tangent of an angle in radians.
/// \param x An angle expressed in radians.
double TanD(double x);

/// \brief Returns the tangent of an angle in radians.
/// \param x An angle expressed in radians.
float TanF(float x);

/// \brief Returns the arcsine in radians of a value.
/// \param x A value in the range [-1, +1] whose arcsine is calculated.
double AsinD(double x);

/// \brief Returns the arcsine in radians of a value.
/// \param x A value in the range [-1, +1] whose arcsine is calculated.
float AsinF(float x);

/// \brief Returns the arccosine in radians of a value.
/// \param x A value in the range [-1, +1] whose arccosine is calculated.
double AcosD(double x);

/// \brief Returns the arccosine in radians of a value.
/// \param x A value in the range [-1, +1] whose arccosine is calculated.
float AcosF(float x);

/// \brief Returns the arctangent in radians of a value.
/// \param x A value in the range [-1, +1] whose arctangent is calculated.
double AtanD(double x);

/// \brief Returns the arctangent in radians of a value.
/// \param x A value in the range [-1, +1] whose arctangent is calculated.
float AtanF(float x);

/// \brief Returns the arctangent in radians of y/x.
/// \param y The coordinate on the Y axis.
/// \param x The coordinate on the X axis.
double Atan2D(double y, double x);

/// \brief Returns the arctangent in radians of y/x.
/// \param y The coordinate on the Y axis.
/// \param x The coordinate on the X axis.
float Atan2F(float y, float x);

/// \brief Returns the hyperbolic sine of a hyperbolic angle.
/// \param x A hyperbolic angle whose hyperbolic sine is calculated.
double SinhD(double x);

/// \brief Returns the hyperbolic sine of a hyperbolic angle.
/// \param x A hyperbolic angle whose hyperbolic sine is calculated.
float SinhF(float x);

/// \brief Returns the hyperbolic cosine of a hyperbolic angle.
/// \param x A hyperbolic angle whose hyperbolic cosine is calculated.
double CoshD(double x);

/// \brief Returns the hyperbolic cosine of a hyperbolic angle.
/// \param x A hyperbolic angle whose hyperbolic cosine is calculated.
float CoshF(float x);

/// \brief Returns the hyperbolic tangent of a hyperbolic angle.
/// \param x A hyperbolic angle whose hyperbolic tangent is calculated.
double TanhD(double x);

/// \brief Returns the hyperbolic tangent of a hyperbolic angle.
/// \param x A hyperbolic angle whose hyperbolic tangent is calculated.
float TanhF(float x);

/// \brief Returns the inverse hyperbolic sine of a value.
/// \param x The value whose inverse hyperbolic sine is calculated.
double AsinhD(double x);

/// \brief Returns the inverse hyperbolic sine of a value.
/// \param x The value whose inverse hyperbolic sine is calculated.
float AsinhF(float x);

/// \brief Returns the inverse hyperbolic cosine of a value.
/// \param x The value whose inverse hyperbolic cosine is calculated.
double AcoshD(double x);

/// \brief Returns the inverse hyperbolic cosine of a value.
/// \param x The value whose inverse hyperbolic cosine is calculated.
float AcoshF(float x);

/// \brief Returns the inverse hyperbolic tangent of a value.
/// \param x The value whose inverse hyperbolic tangent is calculated.
double AtanhD(double x);

/// \brief Returns the inverse hyperbolic tangent of a value.
/// \param x The value whose inverse hyperbolic tangent is calculated.
float AtanhF(float x);

/// \brief Returns e raised to an exponent.
/// \param x The value of the exponent.
double ExpD(double x);

/// \brief Returns e raised to an exponent.
/// \param x The value of the exponent.
float ExpF(float x);

/// \brief Returns 2 raised to an exponent.
/// \param x The value of the exponent.
double Exp2D(double x);

/// \brief Returns 2 raised to an exponent.
/// \param x The value of the exponent.
float Exp2F(float x);

/// \brief Returns the natural logarithm of a value.
/// \param x The value whose natural logarithm is calculated.
double LogD(double x);

/// \brief Returns the natural logarithm of a value.
/// \param x The value whose natural logarithm is calculated.
float LogF(float x);

/// \brief Returns the base-2 logarithm of a value.
/// \param x The value whose logarithm is calculated.
double Log2D(double x);

/// \brief Returns the base-2 logarithm of a value.
/// \param x The value whose logarithm is calculated.
float Log2F(float x);

/// \brief Returns the base-10 logarithm of a value.
/// \param x The value whose logarithm is calculated.
double Log10D(double x);

/// \brief Returns the base-10 logarithm of a value.
/// \param x The value whose logarithm is calculated.
float Log10F(float x);

/// \brief Returns a base value raised to an exponent.
/// \param base The value of the base.
/// \param exponent The value of the exponent.
double PowD(double base, double exponent);

/// \brief Returns a base value raised to an exponent.
/// \param base The value of the base.
/// \param exponent The value of the exponent.
float PowF(float base, float exponent);

/// \brief Returns the square root of a value.
/// \param x The value whose square root is calculated.
double SqrtD(double x);

/// \brief Returns the square root of a value.
/// \param x The value whose square root is calculated.
float SqrtF(float x);

/// \brief Returns the cube root of a value.
/// \param x The value whose square root is calculated.
double CbrtD(double x);

/// \brief Returns the cube root of a value.
/// \param x The value whose square root is calculated.
float CbrtF(float x);

/// \brief Returns the hypotenuse of a right-angled triangle with sides of the given lengths.
/// \param x The length of the first side of the triangle.
/// \param y The length of the second side of the triangle.
double HypotD(double x, double y);

/// \brief Returns the hypotenuse of a right-angled triangle with sides of the given lengths.
/// \param x The length of the first side of the triangle.
/// \param y The length of the second side of the triangle.
float HypotF(float x, float y);

/// \brief Returns a value rounded upward.
/// \param x The value to be rounded.
double CeilD(double x);

/// \brief Returns a value rounded upward.
/// \param x The value to be rounded.
float CeilF(float x);

/// \brief Returns a value rounded downward.
/// \param x The value to be rounded.
double FloorD(double x);

/// \brief Returns a value rounded downward.
/// \param x The value to be rounded.
float FloorF(float x);

/// \brief Returns a value rounded toward zero.
/// \param x The value to be rounded.
double TruncD(double x);

/// \brief Returns a value rounded toward zero.
/// \param x The value to be rounded.
float TruncF(float x);

/// \brief Returns the absolute value of a signed 8-bit value.
/// \param x The value whose absolute value is calculated.
char AbsC(char x);

/// \brief Returns the absolute value of a signed 16-bit value.
/// \param x The value whose absolute value is calculated.
short AbsS(short x);

/// \brief Returns the absolute value of a signed 32-bit value.
/// \param x The value whose absolute value is calculated.
int AbsI(int x);

/// \brief Returns the absolute value of a signed 64-bit value.
/// \param x The value whose absolute value is calculated.
long AbsL(long x);

/// \brief Returns the absolute value of a value.
/// \param x The value whose absolute value is calculated.
double AbsD(double x);

/// \brief Returns the absolute value of a value.
/// \param x The value whose absolute value is calculated.
float AbsF(float x);

/// \brief Returns a value multiplied by 2 raised to an exponent.
/// \param x The value that is multiplied by 2 raised to an exponent.
/// \param exp The exponent.
double LdexpD(double x, int exp);

/// \brief Returns a value multiplied by 2 raised to an exponent.
/// \param x The value that is multiplied by 2 raised to an exponent.
/// \param exp The exponent.
float LdexpF(float x, int exp);

/// \brief Decomposes a value into a fraction and an integral power of two.
/// \param x The value that is decomposed.
/// \param exp A pointer to an int where the exponent is stored.
/// \returns A value whose absolute value is in the range [0.5, 1.0), which, when multiplied by 2 to the power of exp, results in x.
double FrexpD(double x, int *exp);

/// \brief Decomposes a value into a fraction and an integral power of two.
/// \param x The value that is decomposed.
/// \param exp A pointer to an int where the exponent is stored.
/// \returns A value whose absolute value is in the range [0.5, 1.0), which, when multiplied by 2 to the power of exp, results in x.
float FrexpF(float x, int *exp);

/// \brief Decomposes a value into its integral and fractional parts.
/// \param x The value that is decomposed.
/// \param ip A pointer to a double where the integral part is stored.
/// \returns The fractional part, which, when added to ip, results in x.
double ModfD(double x, double *ip);

/// \brief Decomposes a value into its integral and fractional parts.
/// \param x The value that is decomposed.
/// \param ip A pointer to a float where the integral part is stored.
/// \returns The fractional part, which, when added to ip, results in x.
float ModfF(float x, float *ip);

/// \brief Returns the remainder of x/y rounded toward zero.
/// \param x The numerator of the division operation.
/// \param y The denominator of the division operation.
double FmodD(double x, double y);

/// \brief Returns the remainder of x/y rounded toward zero.
/// \param x The numerator of the division operation.
/// \param y The denominator of the division operation.
float FmodF(float x, float y);

/// \brief Returns a value with the magnitude of one and the sign of another.
/// \param x The value whose magnitude is returned.
/// \param y The value whose sign is returned.
double CopySignD(double x, double y);

/// \brief Returns a value with the magnitude of one and the sign of another.
/// \param x The value whose magnitude is returned.
/// \param y The value whose sign is returned.
float CopySignF(float x, float y);

/// \brief Returns a value representing Not-a-Number.
double NaND();

/// \brief Returns a value representing Not-a-Number.
float NaNF();

/// \brief Returns whether a value is Not-a-Number.
/// \param x The value to check.
bool IsNaND(double x);

/// \brief Returns whether a value is Not-a-Number.
/// \param x The value to check.
bool IsNaNF(float x);

/// \brief Returns whether a value is positive or negative infinity.
/// \param x The value to check.
bool IsInfD(double x);

/// \brief Returns whether a value is positive or negative infinity.
/// \param x The value to check.
bool IsInfF(float x);

/// \brief Returns whether a value is neither infinite nor Not-a-Number.
/// \param x The value to check.
bool IsFiniteD(double x);

/// \brief Returns whether a value is neither infinite nor Not-a-Number.
/// \param x The value to check.
bool IsFiniteF(float x);

/// \brief Returns whether the sign bit of a value is set.
/// \param x The value to check.
bool SignBitD(double x);

/// \brief Returns whether the sign bit of a value is set.
/// \param x The value to check.
bool SignBitF(float x);

/// \brief Returns a value rounded to the nearest integer, with halfway cases rounded away from zero.
/// \param x The value to be rounded.
double RoundD(double x);

/// \brief Returns a value rounded to the nearest integer, with halfway cases rounded away from zero.
/// \param x The value to be rounded.
float RoundF(float x);

/// \brief Returns a value rounded to the nearest integer using the current rounding mode.
/// \param x The value to be rounded.
double RintD(double x);

/// \brief Returns a value rounded to the nearest integer using the current rounding mode.
/// \param x The value to be rounded.
float RintF(float x);

/// \brief Returns a value rounded to the nearest integer using the current rounding mode without raising the inexact exception.
/// \param x The value to be rounded.
double NearbyintD(double x);

/// \brief Returns a value rounded to the nearest integer using the current rounding mode without raising the inexact exception.
/// \param x The value to be rounded.
float NearbyintF(float x);

/// \brief Returns the remainder of x/y rounded to the nearest integer.
/// \param x The numerator of the division operation.
/// \param y The denominator of the division operation.
double RemainderD(double x, double y);

/// \brief Returns the remainder of x/y rounded to the nearest integer.
/// \param x The numerator of the division operation.
/// \param y The denominator of the division operation.
float RemainderF(float x, float y);

/// \brief Returns a value rounded to the nearest long integer, with halfway cases rounded away from zero.
/// \param x The value to be rounded.
long LroundD(double x);

/// \brief Returns a value rounded to the nearest long integer, with halfway cases rounded away from zero.
/// \param x The value to be rounded.
long LroundF(float x);

/// \brief Returns the natural logarithm of one plus a value.
/// \param x The value whose logarithm is calculated.
double Log1pD(double x);

/// \brief Returns the natural logarithm of one plus a value.
/// \param x The value whose logarithm is calculated.
float Log1pF(float x);

/// \brief Returns e raised to an exponent minus one.
/// \param x The value of the exponent.
double Expm1D(double x);

/// \brief Returns e raised to an exponent minus one.
/// \param x The value of the exponent.
float Expm1F(float x);

/// \brief Returns the error function of a value.
/// \param x The value whose error function is calculated.
double ErfD(double x);

/// \brief Returns the error function of a value.
/// \param x The value whose error function is calculated.
float ErfF(float x);

/// \brief Returns the complementary error function of a value.
/// \param x The value whose complementary error function is calculated.
double ErfcD(double x);

/// \brief Returns the complementary error function of a value.
/// \param x The value whose complementary error function is calculated.
float ErfcF(float x);

/// \brief Returns the gamma function of a value.
/// \param x The value whose gamma function is calculated.
double TgammaD(double x);

/// \brief Returns the gamma function of a value.
/// \param x The value whose gamma function is calculated.
float TgammaF(float x);

/// \brief Returns the natural logarithm of the absolute value of the gamma function of a value.
/// \param x The value whose log-gamma function is calculated.
double LgammaD(double x);

/// \brief Returns the natural logarithm of the absolute value of the gamma function of a value.
/// \param x The value whose log-gamma function is calculated.
float LgammaF(float x);

/// \brief Returns x * y + z computed with a single rounding.
/// \param x The multiplicand.
/// \param y The multiplier.
/// \param z The value added to the product.
double FmaD(double x, double y, double z);

/// \brief Returns x * y + z computed with a single rounding.
/// \param x The multiplicand.
/// \param y The multiplier.
/// \param z The value added to the product.
float FmaF(float x, float y, float z);

/// \brief Returns the next representable value after x in the direction of y.
/// \param x The starting value.
/// \param y The value that indicates the direction.
double NextafterD(double x, double y);

/// \brief Returns the next representable value after x in the direction of y.
/// \param x The starting value.
/// \param y The value that indicates the direction.
float NextafterF(float x, float y);

/// \brief Returns a value multiplied by 2 raised to an integral exponent.
/// \param x The value that is multiplied by 2 raised to an exponent.
/// \param n The exponent.
double ScalbnD(double x, int n);

/// \brief Returns a value multiplied by 2 raised to an integral exponent.
/// \param x The value that is multiplied by 2 raised to an exponent.
/// \param n The exponent.
float ScalbnF(float x, int n);

/// \brief Returns the unbiased exponent of a value as an integer.
/// \param x The value whose exponent is returned.
int IlogbD(double x);

/// \brief Returns the unbiased exponent of a value as an integer.
/// \param x The value whose exponent is returned.
int IlogbF(float x);

/// \brief Returns the unbiased exponent of a value as a floating-point number.
/// \param x The value whose exponent is returned.
double LogbD(double x);

/// \brief Returns the unbiased exponent of a value as a floating-point number.
/// \param x The value whose exponent is returned.
float LogbF(float x);

/// \brief Returns the remainder of x/y rounded to the nearest integer and stores the low bits of the quotient.
/// \param x The numerator of the division operation.
/// \param y The denominator of the division operation.
/// \param quo A pointer to an int where the low bits of the quotient are stored.
double RemquoD(double x, double y, int *quo);

/// \brief Returns the remainder of x/y rounded to the nearest integer and stores the low bits of the quotient.
/// \param x The numerator of the division operation.
/// \param y The denominator of the division operation.
/// \param quo A pointer to an int where the low bits of the quotient are stored.
float RemquoF(float x, float y, int *quo);

/// \brief Returns a representation of positive infinity.
double InfD();

/// \brief Returns a representation of positive infinity.
float InfF();

