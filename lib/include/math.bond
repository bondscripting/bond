/// \param value The value to limit.
/// \param low The lower bound.
/// \param high The upper bound.
char ClampC(char value, char low, char high);

/// \brief Returns a value limited to the range [low, high].
/// \param value The value to limit.
/// \param low The lower bound.
/// \param high The upper bound.
uchar ClampUC(uchar value, uchar low, uchar high);

